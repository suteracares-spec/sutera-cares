DirectoryIndex index.php
# Laravel front controller for providers.suteracares.org/portal
# The application itself lives at /home/sutempck/portal_app, outside
# the web root, so .env is not reachable over HTTP at all.

<IfModule mod_rewrite.c>
  <IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
  </IfModule>

  RewriteEngine On
  RewriteBase /portal/

  # Handle Authorization header
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Redirect trailing slashes if not a folder
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

  # Send everything that is not a real file to the front controller
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  # The portal shows patient records. Keep them out of caches entirely.
  Header set Cache-Control "no-store, no-cache, must-revalidate, private"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "same-origin"
  # Check-in may record location; camera and microphone stay off.
  Header set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>
